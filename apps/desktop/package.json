{
  "name": "@gestura/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "native:demo": "electron-vite build && electron out/main/native-demo.js",
    "native:bench": "electron-vite build && electron out/main/native-bench.js",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "native:ui-probe": "electron-vite build && electron out/main/native-ui-probe.js",
    "bench:pointing": "electron-vite build && electron . --pointing-bench"
  },
  "dependencies": {
    "@gestura/core": "workspace:*",
    "@gestura/gestures": "workspace:*",
    "@gestura/genai": "workspace:*",
    "@gestura/intent": "workspace:*",
    "@gestura/native": "workspace:*",
    "@gestura/pointer": "workspace:*",
    "@gestura/pointing-bench": "workspace:*",
    "@gestura/replay": "workspace:*",
    "@mediapipe/tasks-vision": "0.10.32",
    "opencc-js": "1.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "selfsigned": "^2.4.1",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.18.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.7.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.2.6"
  }
}
