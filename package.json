{
  "name": "gestura",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "native:build": "node native/gestura-native/scripts/build.mjs",
    "native:demo": "pnpm native:build && pnpm --filter @gestura/desktop native:demo",
    "native:bench": "pnpm native:build && pnpm --filter @gestura/desktop native:bench",
    "dev": "pnpm --filter @gestura/desktop dev",
    "excel:build": "pnpm --filter @gestura/excel-addin build",
    "excel:dev": "node scripts/excel-setup.mjs && pnpm excel:build && pnpm dev",
    "excel:sideload": "mkdir -p \"$HOME/Library/Containers/com.microsoft.Excel/Data/Documents/wef\" && cp integrations/excel-addin/manifest.xml \"$HOME/Library/Containers/com.microsoft.Excel/Data/Documents/wef/\"",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "native:ui-probe": "pnpm native:build && pnpm --filter @gestura/desktop native:ui-probe",
    "models:fetch": "node scripts/fetch-models.mjs",
    "bench:pointing": "pnpm --filter @gestura/desktop bench:pointing",
    "bench:voice": "pnpm --filter @gestura/voice-bench exec node --import tsx src/cli.ts",
    "bench:voice:asr": "node scripts/voice-bench.mjs",
    "bench:formula": "pnpm --filter @gestura/formula-bench exec node --import tsx src/cli.ts",
    "intents:generate": "pnpm --filter @gestura/voice-bench exec node --import tsx src/generate.ts"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
